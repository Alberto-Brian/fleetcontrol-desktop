{
    "name": "FleetControl",
    "productName": "FleetControl",
    "version": "2.0.1",
    "description": "Sistema de Gestão de Frotas",
    "main": ".vite/build/main.js",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "prett": "prettier . --write",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:unit": "jest",
        "test:e2e": "playwright test",
        "test:all": "jest && playwright test",
        "db:studio": "drizzle-kit studio",
        "db:generate": "npx drizzle-kit generate",
        "db:push": "npx drizzle-kit push",
        "db:migrate": "npx drizzle-kit migrate",
        "db:rename": "node src/scripts/rename-migration.js",
        "db:check": "node src/scripts/check-migration.js",
        "rebuild": "electron-rebuild -f -w better-sqlite3",
        "build-icons": "electron-icon-builder --input=./images/fleeticon.png --output=./build --flatten",
        "round-image": "node src/scripts/round-image.js",
        "postinstall": "npm run rebuild",
        "seed": "tsx src/scripts/seed.ts"
    },
    "author": "AKM Systems <albertobrian16@gmail.com>",
